SPORTMONKS_API_TOKEN=your_token_here

# Private scouting app (scout_app.py). Leave these empty here and fill them
# in only in your local, git-ignored .env or in Streamlit Secrets. See
# SCOUTING_SETUP.md.
#
# Supabase connection. The secret key (sb_secret_...) is a full-access
# server-side key: never commit it and never use it in a public app.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
#
# Password that unlocks scout_app.py (an extra layer on top of Streamlit's
# "Only specific people can view this app"). Use a long random one. Without
# it the app stays locked.
SCOUT_APP_PASSWORD=

# Optional: skip the automatic league/season lookup in fetch_data.py by
# setting these directly if your SportMonks subscription names things
# differently, or if the search returns more than one candidate.
# HNL_LEAGUE_ID=your_league_id_here
# HNL_SEASON_ID=your_season_id_here
